# Copy to .env (never commit .env)
NODE_ENV=development
PORT=4000
# Comma-separated explicit allow-list of browser origins
APP_ORIGIN=http://localhost:5173
# Neon POOLED connection string (host contains "-pooler"), used by the API
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Neon DIRECT connection string, used only by `npm run migrate` (optional; falls back to DATABASE_URL)
DIRECT_DATABASE_URL=
# pg (default, TCP 5432) or neon-ws (WebSocket over 443, for networks that block 5432)
DB_DRIVER=pg
SESSION_TTL_HOURS=8
DB_POOL_MAX=10
LOG_LEVEL=info
# Optional: a separate database used only by the DB integration tests
TEST_DATABASE_URL=
# Algolia search (optional). The admin key is backend-only: never put it in frontend or VITE_ variables.
# Without these, search uses PostgreSQL and indexing waits in the outbox.
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
# Optional restricted key with search ACL only (used for query calls)
ALGOLIA_SEARCH_API_KEY=
ALGOLIA_TIMEOUT_MS=3000

# AI assistants (optional). Backend-only key; never put it in frontend or VITE_ variables.
# Without a key the assistants return their fallback (doctors only, no medicines).
GEMINI_API_KEY=
# Use a fast model: the request is cut off after AI_LLM_TIMEOUT_MS, and slower "thinking" models often exceed it.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
AI_LLM_TIMEOUT_MS=8000

# Order confirmation email (optional)
SMTP_URL=
SMTP_FROM=
